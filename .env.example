# DesktopSecretary 环境变量配置
# 复制此文件为 .env 并填写实际值

# ========== 自动更新：公开 HTTP API（推荐，无需 SecretKey）==========
# 把 CloudBase 云函数开启 HTTP 触发器（不鉴权），填入完整 URL
# 客户端直接 fetch 该地址，不需要任何 SecretKey
UPDATE_API_URL=

# ========== 验证码发送：CloudBase 云函数 ==========
# 部署 sendVerifyCode 云函数后，把 HTTP 触发器 URL 填到这里
# 前端构建时会自动注入到 __VERIFY_API_URL__
VERIFY_API_URL=

# ========== 积分系统 / AI 代理云函数 HTTP 触发器 URL ==========
# 部署 cloudbase/functions 下的云函数并开启 HTTP 触发器后填入完整 URL
# 前端构建时注入（vite.config.js 的 define）
AI_PROXY_URL=
GET_BALANCE_URL=
APP_CONFIG_URL=
CREATE_RECHARGE_URL=
QUERY_ORDER_URL=
MOCK_PAY_URL=
DIRECT_RECHARGE_URL=

# ========== 自动更新：CloudBase SDK（需要 SecretKey，兼容旧配置）==========
# 仅当 UPDATE_API_URL 为空时才会使用
# 生产打包时建议留空，避免把密钥打进安装包
TCB_SECRET_ID=
TCB_SECRET_KEY=
TCB_ENV_ID=ds-dev-d9g28xlrgd2600837

# ========== 发布/同步脚本（scripts/build/*.js）==========
# 脚本读取的是 TENCENT_ 前缀（与应用内 TCB_ 前缀不同，两边都填同一对密钥）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# GitHub 下载走本地代理（Clash Verge 默认端口）
PROXY_URL=http://127.0.0.1:7897

# ========== 邮件服务（验证码注册）==========
# 方式1：填在 .env 里（开发模式有效）
# 方式2：填在 config/mail-config.json 里（生产环境推荐）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的SMTP授权码
SMTP_FROM_NAME=DesktopSecretary
